# syntax=docker/dockerfile:1
# Use dev variant for building
FROM dhi.io/node:24-debian13-sfw-dev AS build-stage

ENV NODE_ENV=production
WORKDIR /usr/src/app

# Copy package files
COPY package*.json ./

# Install dependencies and ensure node_modules exists
RUN sfw npm install --omit=dev && mkdir -p node_modules

# Use runtime variant for final image
FROM dhi.io/node:24-debian13 AS runtime-stage

ENV NODE_ENV=production
WORKDIR /usr/src/app

# Copy node_modules from build stage
COPY --from=build-stage /usr/src/app/node_modules ./node_modules

# Copy application code
COPY src ./src
COPY package*.json ./

# Expose port (use non-privileged port)
#EXPOSE 3000

# Start the application
#CMD ["node", "src/index.js"]

# run build

RUN npm run build
